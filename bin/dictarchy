#!/usr/bin/env bash
# dictarchy - speech-to-text via a cloud API for Omarchy 4.5+ (Hyprland Lua
# config, Omarchy shell bar, Omarchy menu). Run "dictarchy help" for an overview.
set -euo pipefail

readonly VERSION="0.2.0"
readonly SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp/dictarchy-runtime-$(id -u)}"

readonly CONFIG_DIR="$CONFIG_HOME/dictarchy"
readonly CONFIG_FILE="$CONFIG_DIR/config"
readonly API_KEY_FILE="$CONFIG_DIR/api_key"
readonly HYPR_DIR="$CONFIG_HOME/hypr"
readonly BINDINGS_FILE="$HYPR_DIR/dictarchy.lua"
readonly OMARCHY_LANGUAGE_FILE="$CONFIG_HOME/omarchy/language"

readonly STATE_DIR="$STATE_HOME/dictarchy"
readonly LANG_FILE="$STATE_DIR/language"
readonly LOG_FILE="$STATE_DIR/dictarchy.log"

readonly RUN_DIR="$RUNTIME_BASE/dictarchy"
readonly LOCK_FILE="$RUN_DIR/lock"
readonly STATE_FILE="$RUN_DIR/state"
readonly STATUS_FILE="$RUN_DIR/status.json"   # watched by the bar widget
readonly PID_FILE="$RUN_DIR/pid"
readonly START_FILE="$RUN_DIR/started_ms"
readonly SESSION_FILE="$RUN_DIR/session"
readonly SHOWN_FILE="$RUN_DIR/shown"
readonly MODE_FILE="$RUN_DIR/mode"              # "ptt" or "toggle"
readonly RELEASED_FILE="$RUN_DIR/ptt_released"  # release seen before its press
readonly WAV_FILE="$RUN_DIR/recording.wav"

readonly ERROR_HOLD_SECONDS=3       # how long an error stays visible
readonly ERROR_TIMEOUT=10           # stale "error" state is ignored after this
readonly TRANSCRIBING_TIMEOUT=120   # stale "transcribing" state is ignored after this
readonly LONG_RECORDING_MS=3000     # silent recordings this long are reported
readonly STOP_WAIT_TENTHS=20        # wait up to 2 s for pw-record to exit
readonly EARLY_RELEASE_MS=1000      # a push-to-talk release this recent cancels its press
readonly TEST_RECORD_SECONDS=4      # length of the sample recorded by "dictarchy test"

# ---------------------------------------------------------------------------
# Configuration defaults (overridden by $CONFIG_FILE, which is parsed, never sourced)
# ---------------------------------------------------------------------------
readonly -a CONFIG_KEYS=(
  API_BASE_URL MODEL LANGUAGE LANGUAGES PROMPT OUTPUT_MODE TRAILING_SPACE
  MIN_DURATION_MS SILENCE_THRESHOLD_DB PTT_KEY PTT_MODS TOGGLE_KEY TOGGLE_MODS NOTIFY OVERLAY
)
readonly -a DEPRECATED_KEYS=(WAYBAR_SIGNAL)   # accepted silently from 0.1 configs
API_BASE_URL="https://api.groq.com/openai/v1"
MODEL="whisper-large-v3-turbo"
LANGUAGE="en"
LANGUAGES="en de auto"
PROMPT=""
OUTPUT_MODE="both"
TRAILING_SPACE="true"
MIN_DURATION_MS=400
SILENCE_THRESHOLD_DB=-50
PTT_KEY="Control_L"
PTT_MODS=""
TOGGLE_KEY="D"
TOGGLE_MODS="SUPER ALT"
NOTIFY="true"
OVERLAY="true"

API_KEY=""        # filled by resolve_api_key, never printed or logged
PTT_MODE=0        # set by parse_ptt_flag
UI_LANG="en"      # language of menus, prompts and notifications (follows Omarchy)
TRANSCRIPT=""     # set by transcribe
HTTP_CODE=""      # set by transcribe / verify_key
API_MESSAGE=""    # set by transcribe

