// Add "custom/dictarchy" to modules-right in ~/.config/waybar/config.jsonc,
// then paste this module definition. "signal" must match WAYBAR_SIGNAL.
// Prefer the output of "dictarchy waybar": it uses absolute paths, because
// Waybar does not always have ~/.local/bin on its PATH.
"custom/dictarchy": {
    "exec": "dictarchy status",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "on-click": "dictarchy toggle",
    "on-click-right": "dictarchy lang next",
    "tooltip": true
}
